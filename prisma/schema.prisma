// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// AUTH

model Admin {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(64)
  passwordHash String    @db.VarChar(255)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @db.Char(64)
  userId    Int
  user      Admin    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Page content

enum Locale {
  en
  sk
  hu
}

model About {
  id         Int    @id @default(autoincrement())
  age        String
  projects   String
  deployed   String
  experience String
}

model Project {
  id       Int     @id @default(autoincrement())
  slug     String  @unique
  title    String
  featured Boolean @default(false)
  order    Int

  stack         String[]
  featuredPhoto String?
  logo          String?
  githubUrl     String?
  liveUrl       String?
  pdf           String?

  status     String?
  launchedAt String?
  period     String?
  role       String?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  projectTranslations ProjectTranslation[]
}

model ProjectTranslation {
  id          Int      @id @default(autoincrement())
  locale      Locale   @default(sk)
  title       String
  subtitle    String
  description String
  tags        String[]
  overview    String?
  highlights  String[]

  stat1      String?
  stat1Value String?
  stat2      String?
  stat2Value String?
  stat3      String?
  stat3Value String?

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([locale, projectId])
}
